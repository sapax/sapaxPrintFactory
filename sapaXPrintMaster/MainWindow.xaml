<Window x:Class="sapaXPrintMaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="sapaX Print Master"
        Height="820"
        Width="760"
        MinHeight="600"
        MinWidth="650"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="#F3F4F6">

    <Window.Resources>

        <!-- ================= COLORS ================= -->
        <SolidColorBrush x:Key="BrushPrimary" Color="#2563EB"/>
        <SolidColorBrush x:Key="BrushSuccess" Color="#16A34A"/>
        <SolidColorBrush x:Key="BrushText" Color="#1F2937"/>
        <SolidColorBrush x:Key="BrushMuted" Color="#6B7280"/>
        <SolidColorBrush x:Key="BrushBorder" Color="#E5E7EB"/>
        <SolidColorBrush x:Key="BrushSoft" Color="#F9FAFB"/>

        <!-- ================= TEXT ================= -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="Status" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
        </Style>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- ================= BUTTONS ================= -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource BrushPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource BrushSuccess}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- ================= TEXT INPUTS ================= -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F3F4F6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= COMBOBOX ================= -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EFF6FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="border" Background="White" BorderBrush="#D1D5DB"
                                                BorderThickness="1" CornerRadius="8">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,12,0" Data="M 0 0 L 4 4 L 8 0"
                                                  Stroke="#6B7280" StrokeThickness="1.6"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,32,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                                        CornerRadius="8" Margin="0,4,0,0"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= CARD (GroupBox) ================= -->
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="White"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <ContentPresenter DockPanel.Dock="Top"
                                                  ContentSource="Header"
                                                  TextElement.FontSize="15"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.Foreground="#1F2937"
                                                  Margin="0,0,0,14"/>
                                <ContentPresenter/>
                            </DockPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= TABS ================= -->
        <Style TargetType="TabControl">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True"/>
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Padding="18,11" Margin="0,0,0,-1"
                                Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,3">
                            <ContentPresenter ContentSource="Header"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#1F2937"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= DATAGRID ================= -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BrushSoft}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="10,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="Foreground" Value="#1F2937"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#F0F1F3"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
        </Style>

    </Window.Resources>

    <Grid>

        <TabControl x:Name="tabsMain" Margin="14,10,14,14">

            <!-- ========================= -->
            <!-- TAB 1: PRINT              -->
            <!-- ========================= -->
            <TabItem x:Name="tabPrint" Header="🖨  Print">
                <Grid MaxWidth="640" Margin="24,28,24,24" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,22">
                        <TextBlock Text="sapaX Print Master" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Send a PDF to the print queue. The agent on this PC prints it."
                                   Foreground="{StaticResource BrushMuted}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Printer Selection -->
                    <GroupBox Grid.Row="1" Header="Printer">
                        <ComboBox x:Name="cmbPrinters" Margin="0"
                                  DisplayMemberPath="PrinterName"
                                  SelectedValuePath="PrinterId"/>
                    </GroupBox>

                    <!-- Select PDF -->
                    <Button x:Name="btnSelectPdf"
                            Grid.Row="2"
                            Height="46"
                            Content="📄  Select PDF file"
                            Click="SelectPdf_Click"
                            Margin="0,0,0,16"
                            FontSize="14"
                            Style="{StaticResource PrimaryButton}"/>

                    <!-- PDF Info -->
                    <GroupBox Grid.Row="3" Header="Selected PDF" MinHeight="150">
                        <Grid>
                            <StackPanel x:Name="pnlNoFile"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="📋" FontSize="40" Opacity="0.3" HorizontalAlignment="Center"/>
                                <TextBlock Text="No PDF file selected"
                                           Foreground="{StaticResource BrushMuted}"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel x:Name="pnlFileInfo" Visibility="Collapsed">
                                <TextBlock x:Name="txtFileName" FontSize="16" FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="txtFilePath" FontSize="11" Margin="0,4,0,0"
                                           Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="txtFileSize" FontSize="12" Margin="0,4,0,0"
                                           Foreground="{StaticResource BrushMuted}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Print Button -->
                    <Button x:Name="btnPrint"
                            Grid.Row="4"
                            Height="50"
                            Content="🖨  Send to print queue"
                            Click="PrintPdf_Click"
                            FontSize="16"
                            IsEnabled="False"
                            Style="{StaticResource SuccessButton}"/>
                </Grid>
            </TabItem>

            <!-- ========================= -->
            <!-- TAB 2: PRINTERS           -->
            <!-- ========================= -->
            <TabItem x:Name="tabPrinters" Header="🖧  Printers">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Installed Printers" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Printers detected on this computer. Active printers appear in the Print tab."
                                       Foreground="{StaticResource BrushMuted}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="🔄  Refresh"
                                    Width="110"
                                    Height="34"
                                    Click="RefreshPrinters_Click"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              x:Name="dgPrinters"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Active" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Tag="Active"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Click="PrinterFlag_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Printer" Binding="{Binding PrinterName}" Width="*"/>
                            <DataGridTextColumn Header="Printer ID" Binding="{Binding PrinterId}" Width="120"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/>
                            <DataGridTemplateColumn Header="Default" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox Tag="Default"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding IsDefault, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  Click="PrinterFlag_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Driver" Binding="{Binding DriverName}" Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ========================= -->
            <!-- TAB 3: JOBS               -->
            <!-- ========================= -->
            <TabItem x:Name="tabJobs" Header="📜  Jobs">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="Print Jobs" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="All jobs in the database: Manual, Power Automate, Power Apps, Web Form."
                       Foreground="{StaticResource BrushMuted}" Margin="0,3,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="{Binding StatusText}" Style="{StaticResource Hint}"/>

                    <DataGrid Grid.Row="2"
                  x:Name="dgJobs"
                  ItemsSource="{Binding Jobs}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Job ID"     Binding="{Binding ShortId}"     Width="80"/>
                            <DataGridTextColumn Header="Printer ID" Binding="{Binding PrinterId}"   Width="110"/>
                            <DataGridTextColumn Header="Printer"    Binding="{Binding PrinterName}" Width="*"/>
                            <DataGridTextColumn Header="File"       Binding="{Binding FileName}"    Width="*"/>
                            <DataGridTextColumn Header="Source"     Binding="{Binding Source}"      Width="110"/>
                            <DataGridTextColumn Header="Status"     Binding="{Binding Status}"      Width="90"/>
                            <DataGridTextColumn Header="Created"    Binding="{Binding Created}"     Width="140"/>
                            <DataGridTextColumn Header="Error"      Binding="{Binding ErrorMessage}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ========================= -->
            <!-- TAB 4: ADMINISTRATOR      -->
            <!-- ========================= -->
            <TabItem x:Name="tabAdmin" Header="🔐  Administrator">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="stkFront" MaxWidth="560" Margin="24,24,24,24">

                        <!-- ========== DATABASE CONNECTION ========== -->
                        <!-- Shown before sign-in until this PC is registered as an agent.
                             After sign-in only a SuperAdmin sees it. -->
                        <GroupBox x:Name="pnlDbConnection" Header="Database Connection">
                            <StackPanel>
                                <TextBlock Text="Server" Style="{StaticResource Label}"/>
                                <TextBox x:Name="txtDbServer"/>

                                <TextBlock Text="Database" Style="{StaticResource Label}"/>
                                <TextBox x:Name="txtDbName"/>

                                <CheckBox x:Name="chkWindowsAuth" Content="Use Windows Authentication"
                                          Margin="0,0,0,14"
                                          Checked="chkWindowsAuth_Changed" Unchecked="chkWindowsAuth_Changed"/>

                                <StackPanel x:Name="pnlSqlAuth">
                                    <TextBlock Text="Username" Style="{StaticResource Label}"/>
                                    <TextBox x:Name="txtDbUser"/>
                                    <TextBlock Text="Password (leave empty to keep the saved one)" Style="{StaticResource Label}"/>
                                    <PasswordBox x:Name="pwdDb"/>
                                </StackPanel>

                                <Button x:Name="btnSaveDb" Content="Test &amp; Save Connection"
                                        Style="{StaticResource PrimaryButton}" Click="SaveDb_Click"/>
                                <TextBlock x:Name="txtDbStatus" Style="{StaticResource Status}"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- ========== CREATE TABLES ========== -->
                        <GroupBox x:Name="pnlTablesStep" Header="Create Tables" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="Only missing tables are listed. Before sign-in only the Users table can be created."/>
                                <TextBlock Text="Table" Style="{StaticResource Label}"/>
                                <ComboBox x:Name="cmbTemplateTable"/>
                                <Button x:Name="btnCreateTable" Content="Create Table" Margin="0,0,0,8"
                                        Style="{StaticResource SuccessButton}" Click="CreateTable_Click"/>
                                <Button x:Name="btnCreateAll" Content="Create all missing tables"
                                        Style="{StaticResource PrimaryButton}" Click="CreateAll_Click"
                                        Visibility="Collapsed"/>
                                <TextBlock x:Name="txtTablesStatus" Style="{StaticResource Status}"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- ========== CREATE FIRST SUPERADMIN ========== -->
                        <GroupBox x:Name="pnlCreateAdmin" Header="Create SuperAdmin" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="No SuperAdmin exists yet. The first account is always a SuperAdmin."/>
                                <TextBlock Text="User ID" Style="{StaticResource Label}"/>
                                <TextBox x:Name="txtNewAdminUserId"/>
                                <TextBlock Text="Password" Style="{StaticResource Label}"/>
                                <PasswordBox x:Name="pwdNewAdminPassword"/>
                                <TextBlock Text="Name (optional)" Style="{StaticResource Label}"/>
                                <TextBox x:Name="txtNewAdminUserName"/>
                                <TextBlock Text="Email (optional)" Style="{StaticResource Label}"/>
                                <TextBox x:Name="txtNewAdminEmail"/>
                                <Button Content="Create SuperAdmin"
                                        Style="{StaticResource SuccessButton}" Click="CreateFirstAdmin_Click"/>
                                <TextBlock x:Name="txtCreateAdminStatus" Style="{StaticResource Status}"
                                           Visibility="Collapsed"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- ========== SIGN IN ========== -->
                        <GroupBox x:Name="pnlLogin" Header="Sign in" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="User ID" Style="{StaticResource Label}"/>
                                <TextBox x:Name="txtUsername"/>
                                <TextBlock Text="Password" Style="{StaticResource Label}"/>
                                <PasswordBox x:Name="pwdPassword" KeyDown="pwdPassword_KeyDown"/>
                                <TextBlock x:Name="txtLoginError" Foreground="#DC2626" TextWrapping="Wrap"
                                           Visibility="Collapsed" Margin="0,0,0,12"/>
                                <Button Content="Sign in" Style="{StaticResource PrimaryButton}"
                                        Click="Login_Click" Margin="0,0,0,12"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- ========== AFTER SIGN-IN ========== -->
                        <StackPanel x:Name="pnlAdmin" Visibility="Collapsed">

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Administrator" Style="{StaticResource PageTitle}"/>
                                    <TextBlock x:Name="txtLoggedInAs" Foreground="{StaticResource BrushMuted}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Sign out" Width="100" Height="34"
                                        VerticalAlignment="Center" Click="Logout_Click"/>
                            </Grid>

                            <TabControl x:Name="tabsAdmin">

                                <!-- DATABASE -->
                                <TabItem x:Name="tabDatabase" Header="Database">
                                    <StackPanel Margin="0,16,0,0">
                                        <GroupBox Header="Tables">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <TextBlock x:Name="txtTableCount"
                                                               Foreground="{StaticResource BrushMuted}"
                                                               VerticalAlignment="Center"/>
                                                    <Button Content="Refresh" HorizontalAlignment="Right"
                                                            Width="90" Height="32" Click="RefreshTables_Click"/>
                                                </Grid>
                                                <DataGrid x:Name="dgTables" Height="240" AutoGenerateColumns="False"
                                                          IsReadOnly="True" CanUserAddRows="False">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Schema" Binding="{Binding SchemaName}" Width="90"/>
                                                        <DataGridTextColumn Header="Table" Binding="{Binding TableName}" Width="*"/>
                                                        <DataGridTextColumn Header="Rows" Binding="{Binding Rows}" Width="80"/>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                </TabItem>

                                <!-- ORGANIZATION (SuperAdmin only) -->
                                <TabItem x:Name="tabOrg" Header="Organization">
                                    <StackPanel Margin="0,16,0,0">
                                        <GroupBox Header="Add Company">
                                            <StackPanel>
                                                <TextBlock Text="Company ID" Style="{StaticResource Label}"/>
                                                <TextBox x:Name="txtCompanyId"/>
                                                <TextBlock Text="Company name" Style="{StaticResource Label}"/>
                                                <TextBox x:Name="txtCompanyName"/>
                                                <Button Content="Add Company" Style="{StaticResource PrimaryButton}"
                                                        Click="AddCompany_Click"/>
                                            </StackPanel>
                                        </GroupBox>

                                        <GroupBox Header="Add Sub Area">
                                            <StackPanel>
                                                <TextBlock Text="Company" Style="{StaticResource Label}"/>
                                                <ComboBox x:Name="cmbMgrCompany" DisplayMemberPath="Display"/>
                                                <TextBlock Text="Sub area ID" Style="{StaticResource Label}"/>
                                                <TextBox x:Name="txtSubAreaId"/>
                                                <TextBlock Text="Sub area name" Style="{StaticResource Label}"/>
                                                <TextBox x:Name="txtSubAreaName"/>
                                                <Button Content="Add Sub Area" Style="{StaticResource PrimaryButton}"
                                                        Click="AddSubArea_Click"/>
                                            </StackPanel>
                                        </GroupBox>

                                        <TextBlock x:Name="txtOrgStatus" Style="{StaticResource Status}"
                                                   Margin="2,0,0,16"/>
                                    </StackPanel>
                                </TabItem>

                                <!-- AGENT -->
                                <TabItem x:Name="tabComputer" Header="Agent">
                                    <StackPanel Margin="0,16,0,0">

                                        <TextBlock x:Name="txtAgentLocked" Visibility="Collapsed"
                                                   Style="{StaticResource Hint}"
                                                   Text="Only a SuperAdmin can register this computer and its printers."/>

                                        <GroupBox x:Name="pnlRegister" Header="Register this computer as an agent">
                                            <StackPanel>
                                                <TextBlock Text="Computer ID (= Agent ID)" Style="{StaticResource Label}"/>
                                                <TextBox x:Name="txtComputerId" IsReadOnly="True"/>

                                                <TextBlock Text="Agent name (e.g. Packing Line 1 PC)" Style="{StaticResource Label}"/>
                                                <TextBox x:Name="txtAgentName"/>

                                                <TextBlock Text="Printers on this computer (select one or more)" Style="{StaticResource Label}"/>
                                                <ListBox x:Name="lstAgentPrinters"
                                                         SelectionMode="Multiple"
                                                         DisplayMemberPath="PrinterName"
                                                         Height="130"
                                                         Margin="0,0,0,14"
                                                         BorderBrush="#D1D5DB"
                                                         BorderThickness="1"/>

                                                <TextBlock Text="Company" Style="{StaticResource Label}"/>
                                                <ComboBox x:Name="cmbCompany" DisplayMemberPath="Display"
                                                          SelectionChanged="cmbCompany_SelectionChanged"/>

                                                <TextBlock Text="Sub area" Style="{StaticResource Label}"/>
                                                <ComboBox x:Name="cmbSubArea" DisplayMemberPath="Display"/>

                                                <Button x:Name="btnRegister" Content="Register computer"
                                                        Style="{StaticResource SuccessButton}"
                                                        Click="RegisterComputer_Click"/>
                                                <TextBlock x:Name="txtRegisterStatus" Style="{StaticResource Status}"/>
                                            </StackPanel>
                                        </GroupBox>

                                        <GroupBox Header="Job polling">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Hint}"
                                                           Text="How often this computer asks the database for new print jobs (seconds)."/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBox x:Name="txtPollSeconds" Width="120" Margin="0"/>
                                                    <Button x:Name="btnSavePoll" Content="Save" Width="100"
                                                            Margin="12,0,0,0" Style="{StaticResource PrimaryButton}"
                                                            Click="SavePoll_Click"/>
                                                </StackPanel>
                                                <TextBlock x:Name="txtPollStatus" Style="{StaticResource Status}"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                </TabItem>
                                
                                <!-- REGISTERED PRINTERS -->
                                <TabItem x:Name="tabRegistered" Header="Registered Printers">
                                    <StackPanel Margin="0,16,0,0">

                                        <TextBlock Style="{StaticResource Hint}"
                   Text="Printers registered for each computer (Agent ID). Inactive printers were unselected at registration."/>

                                        <TextBlock Text="Computer (Agent ID)" Style="{StaticResource Label}"/>
                                        <ComboBox x:Name="cmbRegComputer" DisplayMemberPath="Display"
                  SelectionChanged="cmbRegComputer_SelectionChanged"/>

                                        <Button x:Name="btnRefreshRegistered" Content="Refresh" Width="120" Height="34"
                HorizontalAlignment="Left" Margin="0,0,0,12"
                Click="RefreshRegistered_Click"/>

                                        <DataGrid x:Name="dgRegistered" Height="320" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Agent ID" Binding="{Binding ComputerID}" Width="150"/>
                                                <DataGridTextColumn Header="Agent name" Binding="{Binding ComputerName}" Width="*"/>
                                                <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="110"/>
                                                <DataGridTextColumn Header="Sub area" Binding="{Binding SubAreaName}" Width="110"/>
                                                <DataGridTextColumn Header="Printer ID" Binding="{Binding PrinterID}" Width="110"/>
                                                <DataGridTextColumn Header="Printer" Binding="{Binding PrinterName}" Width="*"/>
                                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding Active}" Width="60"/>
                                                <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="120"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <TextBlock x:Name="txtRegisteredStatus" Style="{StaticResource Status}"/>
                                    </StackPanel>
                                </TabItem>
                                
                                <!-- USERS -->
                                <TabItem x:Name="tabUsers" Header="Users">
                                    <StackPanel Margin="0,16,0,0">
                                        <GroupBox Header="Add User">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Hint}"
                                                           Text="Administrators can add standard users. Only a SuperAdmin can add administrators."/>
                                                <TextBlock Text="Role" Style="{StaticResource Label}"/>
                                                <ComboBox x:Name="cmbNewUserRole"/>
                                                <TextBlock Text="User ID" Style="{StaticResource Label}"/>
                                                <TextBox x:Name="txtAddUserId"/>
                                                <TextBlock Text="Password" Style="{StaticResource Label}"/>
                                                <PasswordBox x:Name="pwdAddUserPassword"/>
                                                <TextBlock Text="Name (optional)" Style="{StaticResource Label}"/>
                                                <TextBox x:Name="txtAddUserName"/>
                                                <TextBlock Text="Email (optional)" Style="{StaticResource Label}"/>
                                                <TextBox x:Name="txtAddUserEmail"/>
                                                <Button x:Name="btnAddUser" Content="Add User"
                                                        Style="{StaticResource SuccessButton}" Click="AddUser_Click"/>
                                                <TextBlock x:Name="txtAddUserStatus" Style="{StaticResource Status}"/>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                                </TabItem>

                            </TabControl>

                            <GroupBox x:Name="pnlNoAccess" Header="Limited access" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource Hint}" Margin="0"
                                           Text="Your account is a standard user. Administrator settings are only available to administrators."/>
                            </GroupBox>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

    </Grid>
</Window>