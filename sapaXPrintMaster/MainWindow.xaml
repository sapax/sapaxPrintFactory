<Window x:Class="sapaXPrintMaster.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="sapaX Print Master"
        Height="1000"
        Width="750"
        MinHeight="600"
        MinWidth="650"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Grid>

        <TabControl Margin="10">

            <!-- ========================= -->
            <!-- TAB 1: PRINT              -->
            <!-- ========================= -->
            <TabItem Header="🖨 Print">
                <Grid Margin="25">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,25">
                        <TextBlock Text="sapaX Print Master"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#2C3E50"/>
                        <TextBlock Text="Silent PDF Printing Tool"
                                   FontSize="13"
                                   Foreground="#7F8C8D"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Printer Selection -->
                    <GroupBox Grid.Row="1"
                              Header="Select Printer"
                              Padding="15"
                              Margin="0,0,0,15"
                              Background="White">
                        <ComboBox x:Name="cmbPrinters"
                                  Height="35"
                                  FontSize="14"
                                  VerticalContentAlignment="Center">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBox">
                                                <Grid>
                                                    <ToggleButton x:Name="ToggleButton"
                                                                  Focusable="false"
                                                                  IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                  ClickMode="Press">
                                                        <ToggleButton.Template>
                                                            <ControlTemplate TargetType="ToggleButton">
                                                                <Border x:Name="border"
                                                                        Background="White"
                                                                        BorderBrush="#D0D0D0"
                                                                        BorderThickness="1"
                                                                        CornerRadius="5">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition/>
                                                                            <ColumnDefinition Width="30"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <ContentPresenter Grid.Column="0"
                                                                                          HorizontalAlignment="Left"
                                                                                          VerticalAlignment="Center"
                                                                                          Margin="10,0,0,0"/>
                                                                        <Path x:Name="Arrow"
                                                                              Grid.Column="1"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"
                                                                              Data="M 0 0 L 4 4 L 8 0 Z"
                                                                              Fill="#666666"/>
                                                                    </Grid>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="border" Property="BorderBrush" Value="#3498DB"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </ToggleButton.Template>
                                                    </ToggleButton>
                                                    <ContentPresenter x:Name="ContentSite"
                                                                      IsHitTestVisible="False"
                                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                      ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                                      Margin="10,0,30,0"
                                                                      VerticalAlignment="Center"
                                                                      HorizontalAlignment="Left"/>
                                                    <Popup x:Name="Popup"
                                                           Placement="Bottom"
                                                           IsOpen="{TemplateBinding IsDropDownOpen}"
                                                           AllowsTransparency="True"
                                                           Focusable="False"
                                                           PopupAnimation="Slide">
                                                        <Border x:Name="DropDownBorder"
                                                                Background="White"
                                                                BorderBrush="#D0D0D0"
                                                                BorderThickness="1"
                                                                CornerRadius="5"
                                                                MinWidth="{TemplateBinding ActualWidth}"
                                                                MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                            <ScrollViewer Margin="4,6,4,6"
                                                                          SnapsToDevicePixels="True">
                                                                <StackPanel IsItemsHost="True"
                                                                            KeyboardNavigation.DirectionalNavigation="Contained"/>
                                                            </ScrollViewer>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </GroupBox>

                    <!-- Select PDF -->
                    <Button x:Name="btnSelectPdf"
                            Grid.Row="2"
                            Height="45"
                            Content="📄 Select PDF File"
                            Click="SelectPdf_Click"
                            Margin="0,0,0,15"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Background="#3498DB"
                            Foreground="White"
                            BorderThickness="0"/>

                    <!-- PDF Info -->
                    <GroupBox Grid.Row="3"
                              Header="Selected PDF"
                              Padding="15"
                              Margin="0,0,0,15"
                              Background="White"
                              MinHeight="150">
                        <Grid>
                            <StackPanel x:Name="pnlNoFile"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="📋"
                                           FontSize="48"
                                           Opacity="0.3"/>
                                <TextBlock Text="No PDF file selected"
                                           FontSize="14"
                                           Foreground="#95A5A6"/>
                            </StackPanel>

                            <StackPanel x:Name="pnlFileInfo"
                                        Visibility="Collapsed">
                                <TextBlock x:Name="txtFileName"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock x:Name="txtFilePath"
                                           FontSize="11"
                                           Foreground="#7F8C8D"/>
                                <TextBlock x:Name="txtFileSize"
                                           FontSize="12"
                                           Foreground="#95A5A6"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Print Button -->
                    <Button x:Name="btnPrint"
                            Grid.Row="4"
                            Height="50"
                            Content="🖨️ Print"
                            Click="PrintPdf_Click"
                            FontSize="16"
                            FontWeight="Bold"
                            Background="#27AE60"
                            Foreground="White"
                            BorderThickness="0"
                            IsEnabled="False"/>
                </Grid>
            </TabItem>

            <!-- ========================= -->
            <!-- TAB 2: PRINTERS           -->
            <!-- ========================= -->
            <TabItem Header="🖧 Printers">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="Installed Printers"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#2C3E50"/>
                            <TextBlock Text="Printers detected on this computer"
                                       FontSize="13"
                                       Foreground="#7F8C8D"/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Content="🔄 Refresh"
                                Width="100"
                                Height="32"
                                Margin="10,0,0,0"
                                Click="RefreshPrinters_Click"
                                Background="#ECF0F1"
                                BorderBrush="#BDC3C7"
                                Cursor="Hand"/>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              x:Name="dgPrinters"
                              CurrentCellChanged="dgPrinters_CurrentCellChanged"
                              AutoGenerateColumns="False"
                              IsReadOnly="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              RowHeight="36"
                              Background="White"
                              BorderBrush="#DADADA"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Active"
                                                    Binding="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="60"/>
                            <DataGridTextColumn Header="Printer"
                                                Binding="{Binding PrinterName}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Printer ID"
                                                Binding="{Binding PrinterId}"
                                                Width="120"/>
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                Width="90"/>
                            <DataGridCheckBoxColumn Header="Default"
                                                    Binding="{Binding IsDefault, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="70"/>
                            <DataGridTextColumn Header="Driver"
                                                Binding="{Binding DriverName}"
                                                Width="180"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ========================= -->
            <!-- TAB 3: JOBS               -->
            <!-- ========================= -->
            <TabItem Header="📜 Jobs">
                <Grid Margin="10">
                    <DataGrid x:Name="dgJobs"
                              ItemsSource="{Binding Jobs}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Job ID"
                                                Binding="{Binding JobId}"
                                                Width="80"/>
                            <DataGridTextColumn Header="Printer"
                                                Binding="{Binding PrinterName}"
                                                Width="*"/>
                            <DataGridTextColumn Header="File"
                                                Binding="{Binding FileName}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding Status}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Created"
                                                Binding="{Binding CreatedAt}"
                                                Width="130"/>
                            <DataGridTextColumn Header="Error"
                                                Binding="{Binding LastError}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- ========================= -->
            <!-- TAB 4: ADMINISTRATOR      -->
            <!-- ========================= -->
            <TabItem Header="🔐 Administrator">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">

                        <!-- ========== 1. DATABASE CONNECTION ========== -->
                        <GroupBox Header="1. Database Connection" Padding="15" Background="White">
                            <StackPanel>
                                <TextBlock Text="Server" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtDbServer" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                                <TextBlock Text="Database" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtDbName" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                                <CheckBox x:Name="chkWindowsAuth" Content="Use Windows Authentication" Margin="0,0,0,10"
                                          Checked="chkWindowsAuth_Changed" Unchecked="chkWindowsAuth_Changed"/>

                                <StackPanel x:Name="pnlSqlAuth">
                                    <TextBlock Text="DB Username" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtDbUser" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="DB Password (leave empty to keep the saved one)" Margin="0,0,0,4"/>
                                    <PasswordBox x:Name="pwdDb" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                                </StackPanel>

                                <Button x:Name="btnSaveDb" Content="Test &amp; Save Connection" Height="36" FontWeight="SemiBold"
                                        Background="#3498DB" Foreground="White" BorderThickness="0" Cursor="Hand"
                                        Click="SaveDb_Click"/>
                                <TextBlock x:Name="txtDbStatus" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- ========== 2. TABLES ========== -->
                        <GroupBox x:Name="pnlTablesStep" Header="2. Create Tables" Padding="15" Margin="0,15,0,0"
                                  Background="White" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Before login only the Users table can be created. After login you can create every table."
                                           FontSize="12" Foreground="#7F8C8D" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBlock Text="Table template" Margin="0,0,0,4"/>
                                <ComboBox x:Name="cmbTemplateTable" Height="32" Margin="0,0,0,10"/>
                                <Button x:Name="btnCreateTable" Content="Create Table" Height="36" FontWeight="SemiBold"
                                        Background="#27AE60" Foreground="White" BorderThickness="0" Cursor="Hand"
                                        Click="CreateTable_Click" Margin="0,0,0,8"/>
                                <Button x:Name="btnCreateAll" Content="Create ALL missing tables" Height="36" FontWeight="SemiBold"
                                        Background="#16A085" Foreground="White" BorderThickness="0" Cursor="Hand"
                                        Click="CreateAll_Click" Visibility="Collapsed"/>
                                <TextBlock x:Name="txtTablesStatus" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- ========== 3. CREATE FIRST ADMIN ========== -->
                        <GroupBox x:Name="pnlCreateAdmin" Header="3. Create Administrator" Padding="15" Margin="0,15,0,0"
                                  Background="White" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="No administrator exists yet. Create the first one to continue."
                                           FontSize="12" Foreground="#7F8C8D" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBlock Text="User ID" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtNewAdminUserId" Height="32" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                                <TextBlock Text="Password" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="pwdNewAdminPassword" Height="32" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                                <TextBlock Text="User Name (optional)" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtNewAdminUserName" Height="32" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                                <TextBlock Text="Email (optional)" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtNewAdminEmail" Height="32" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                                <TextBlock x:Name="txtCreateAdminStatus" TextWrapping="Wrap" FontWeight="SemiBold"
                                           Visibility="Collapsed" Margin="0,0,0,10"/>
                                <Button Content="Create Administrator" Height="38" FontWeight="SemiBold" Background="#27AE60"
                                        Foreground="White" BorderThickness="0" Cursor="Hand" Click="CreateFirstAdmin_Click"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- ========== 4. LOGIN ========== -->
                        <GroupBox x:Name="pnlLogin" Header="4. Login" Padding="15" Margin="0,15,0,0"
                                  Background="White" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="User ID" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtUsername" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Password" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="pwdPassword" Height="32" VerticalContentAlignment="Center"
                                             KeyDown="pwdPassword_KeyDown" Margin="0,0,0,10"/>
                                <TextBlock x:Name="txtLoginError" Foreground="#C0392B" TextWrapping="Wrap"
                                           Visibility="Collapsed" Margin="0,0,0,10"/>
                                <Button Content="Login" Height="38" FontWeight="SemiBold" Background="#3498DB"
                                        Foreground="White" BorderThickness="0" Cursor="Hand" Click="Login_Click" Margin="0,0,0,10"/>
                                <TextBlock HorizontalAlignment="Center">
                                    <Hyperlink Click="ShowSignUp_Click">Create an account</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>

                        <!-- SIGN UP -->
                        <GroupBox x:Name="pnlSignUp" Header="Create Account" Padding="15" Margin="0,15,0,0"
                                  Background="White" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Use sapax_YourID to register as an administrator."
                                           FontSize="11" Foreground="#7F8C8D" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBlock Text="User ID" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtSignupUserId" Height="32" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                                <TextBlock Text="Password" Margin="0,0,0,4"/>
                                <PasswordBox x:Name="pwdSignupPassword" Height="32" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                                <TextBlock Text="User Name (optional)" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtSignupUserName" Height="32" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                                <TextBlock Text="Email (optional)" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtSignupEmail" Height="32" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                                <TextBlock Text="Activation Key (required for normal users)" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtSignupActivationKey" Height="32" Margin="0,0,0,10" VerticalContentAlignment="Center"/>
                                <TextBlock x:Name="txtSignupStatus" TextWrapping="Wrap" FontWeight="SemiBold"
                                           Visibility="Collapsed" Margin="0,0,0,10"/>
                                <Button Content="Create Account" Height="38" FontWeight="SemiBold" Background="#27AE60"
                                        Foreground="White" BorderThickness="0" Cursor="Hand" Click="SignUp_Click" Margin="0,0,0,10"/>
                                <TextBlock HorizontalAlignment="Center">
                                    <Hyperlink Click="ShowLogin_Click">Back to login</Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>

                        <!-- ========== AFTER LOGIN ========== -->
                        <StackPanel x:Name="pnlAdmin" Visibility="Collapsed" Margin="0,15,0,0">

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Administrator" FontSize="20" FontWeight="Bold" Foreground="#2C3E50"/>
                                    <TextBlock x:Name="txtLoggedInAs" FontSize="13" Foreground="#7F8C8D"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Logout" Width="100" Height="32" Background="#ECF0F1"
                                        BorderBrush="#BDC3C7" Cursor="Hand" Click="Logout_Click"/>
                            </Grid>

                            <!-- Companies & sub areas -->
                            <GroupBox Header="Companies &amp; Sub Areas" Padding="15" Background="White">
                                <StackPanel>
                                    <TextBlock Text="Add company" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtCompanyId" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,0"
                                                 ToolTip="Company ID"/>
                                        <TextBox x:Name="txtCompanyName" Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                                                 Margin="0,0,8,0" ToolTip="Company name"/>
                                        <Button Grid.Column="2" Content="Add" Width="70" Click="AddCompany_Click"/>
                                    </Grid>
                                    <TextBlock Text="(left: Company ID, right: Company name)" FontSize="11" Foreground="#95A5A6" Margin="0,-6,0,10"/>

                                    <TextBlock Text="Add sub area" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ComboBox x:Name="cmbMgrCompany" Height="30" DisplayMemberPath="Display" Margin="0,0,0,6"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtSubAreaId" Height="30" VerticalContentAlignment="Center" Margin="0,0,8,0"
                                                 ToolTip="Sub area ID"/>
                                        <TextBox x:Name="txtSubAreaName" Grid.Column="1" Height="30" VerticalContentAlignment="Center"
                                                 Margin="0,0,8,0" ToolTip="Sub area name"/>
                                        <Button Grid.Column="2" Content="Add" Width="70" Click="AddSubArea_Click"/>
                                    </Grid>
                                    <TextBlock Text="(left: Sub area ID, right: Sub area name)" FontSize="11" Foreground="#95A5A6"/>
                                    <TextBlock x:Name="txtOrgStatus" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Register computer -->
                            <GroupBox Header="Register this computer as an agent" Padding="15" Margin="0,15,0,0" Background="White">
                                <StackPanel>
                                    <TextBlock Text="Computer ID (= Agent ID)" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtComputerId" Height="30" IsReadOnly="True" Background="#ECECEC"
                                             VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                                    <TextBlock Text="Agent name (custom, e.g. Packing Line 1 PC)" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtAgentName" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                                    <TextBlock Text="Company" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cmbCompany" Height="30" DisplayMemberPath="Display" Margin="0,0,0,10"
                                              SelectionChanged="cmbCompany_SelectionChanged"/>

                                    <TextBlock Text="Sub area" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="cmbSubArea" Height="30" DisplayMemberPath="Display" Margin="0,0,0,10"/>

                                    <TextBlock Text="Cloud URL" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtCloudUrl" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,12"/>

                                    <Button x:Name="btnRegister" Content="Register computer" Height="38" FontWeight="SemiBold"
                                            Background="#27AE60" Foreground="White" BorderThickness="0" Cursor="Hand"
                                            Click="RegisterComputer_Click"/>
                                    <TextBlock x:Name="txtRegisterStatus" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,10,0,0"/>

                                    <Separator Margin="0,14,0,14"/>

                                    <TextBlock Text="API key for this agent" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtApiKey" Height="30" IsReadOnly="True" Background="#ECECEC"
                                             VerticalContentAlignment="Center" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox x:Name="chkShowKey" Content="Show" VerticalAlignment="Center" Margin="0,0,16,0"
                                                  Checked="ShowKey_Changed" Unchecked="ShowKey_Changed"/>
                                        <Button Content="Copy" Width="80" Height="28" Margin="0,0,8,0" Click="CopyKey_Click"/>
                                        <Button Content="Regenerate" Width="100" Height="28" Click="RegenerateKey_Click"/>
                                    </StackPanel>
                                    <TextBlock Text="The database stores only a hash of the key. It is saved encrypted on this PC so you can see it here after login."
                                               FontSize="11" Foreground="#7F8C8D" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Table list -->
                            <GroupBox Header="Database Tables" Padding="15" Margin="0,15,0,0" Background="White">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock x:Name="txtTableCount" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                                        <Button Content="Refresh" HorizontalAlignment="Right" Width="90" Click="RefreshTables_Click"/>
                                    </Grid>
                                    <DataGrid x:Name="dgTables" Height="220" AutoGenerateColumns="False" IsReadOnly="True"
                                              CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Schema" Binding="{Binding SchemaName}" Width="80"/>
                                            <DataGridTextColumn Header="Table" Binding="{Binding TableName}" Width="*"/>
                                            <DataGridTextColumn Header="Rows" Binding="{Binding Rows}" Width="80"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- ========================================= -->
        <!-- ACTIVATION OVERLAY (blocks everything       -->
        <!-- until a valid key is entered, shown only    -->
        <!-- once per machine unless the key expires)    -->
        <!-- ========================================= -->
        <Grid x:Name="pnlActivationOverlay"
              Background="#CC1A1A1A"
              Visibility="Collapsed">
            <Border Width="360"
                    Padding="28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="White"
                    CornerRadius="8">
                <StackPanel>
                    <TextBlock Text="🔒"
                               FontSize="36"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="Activate sapaX Print Master"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="#2C3E50"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Enter your activation key to continue. You only need to do this once."
                               FontSize="12"
                               Foreground="#7F8C8D"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,18"/>

                    <TextBlock Text="Activation Key" Foreground="#2C3E50" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtActivationKey"
                             Height="34"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             KeyDown="txtActivationKey_KeyDown"
                             Margin="0,0,0,14"/>

                    <TextBlock x:Name="txtActivationStatus"
                               TextWrapping="Wrap"
                               FontWeight="SemiBold"
                               Margin="0,0,0,14"
                               Visibility="Collapsed"/>

                    <Button x:Name="btnActivate"
                            Content="Activate"
                            Height="38"
